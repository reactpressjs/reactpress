{
  "name": "@reactpressjs/reactpress-server",
  "version": "5.0.0-beta.0",
  "deprecated": "Bundled in @reactpressjs/reactpress CLI from v3.1. Run `npx @reactpressjs/reactpress init` for new projects.",
  "description": "ReactPress NestJS REST API (deprecated). Bundled in @reactpressjs/reactpress CLI from v3.1. Headless CMS for articles, media, plugins, and themes",
  "author": "reactpressjs",
  "license": "MIT",
  "homepage": "https://reactpress.cc/",
  "bugs": {
    "url": "https://github.com/reactpressjs/reactpress/issues"
  },
  "main": "dist/main.js",
  "bin": {
    "reactpress-server": "./bin/reactpress-server.js"
  },
  "files": [
    "dist/**/*",
    "public/**/*",
    "bin/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "reactpress",
    "nestjs",
    "headless-cms",
    "cms",
    "blog",
    "rest-api",
    "api",
    "openapi",
    "swagger",
    "typescript",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactpressjs/reactpress.git",
    "directory": "server"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "nest build && npm run copy-assets",
    "copy-assets": "cp -r public dist/ 2>/dev/null || true",
    "format": "prettier --write \"src/**/*.ts\"",
    "predev": "node scripts/ensure-dev-dist.js",
    "dev": "cross-env REACTPRESS_API_ENTRY=starter nest start --watch",
    "debug": "nest start --debug --watch",
    "start": "cross-env NODE_ENV=production node dist/main",
    "pm2": "pm2 start npm --name @reactpressjs/reactpress-server -- start",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepublishOnly": "npm run build",
    "pm2:start": "pm2 start dist/main.js --name reactpress-server",
    "pm2:stop": "pm2 stop reactpress-server",
    "pm2:restart": "pm2 restart reactpress-server",
    "pm2:delete": "pm2 delete reactpress-server",
    "pm2:logs": "pm2 logs reactpress-server",
    "pm2:status": "pm2 status reactpress-server",
    "generate:swagger": "ts-node src/generate-swagger.ts"
  },
  "dependencies": {
    "@reactpressjs/reactpress-toolkit": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "ali-oss": "^6.5.1",
    "axios": "^0.23.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "class-transformer": "^0.5.1",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "date-fns": "^2.17.0",
    "deepmerge": "^4.2.2",
    "dotenv": "^8.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "fs-extra": "^10.0.0",
    "helmet": "^7.2.0",
    "highlight.js": "^9.18.0",
    "lodash": "^4.17.21",
    "log4js": "^6.1.0",
    "marked": "^0.8.0",
    "mysql2": "^3.12.0",
    "node-ip2region": "^1.0.2",
    "nodemailer": "^6.4.2",
    "nuid": "^1.1.0",
    "open": "^8.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pm2": "^5.2.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^3.0.0",
    "rxjs": "^7.8.1",
    "segment": "^0.1.3",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7",
    "swagger-themes": "^1.4.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "ua-parser-js": "^0.7.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "collectCoverageFrom": [
      "modules/**/*.ts",
      "utils/**/*.ts",
      "filters/**/*.ts",
      "interceptors/**/*.ts",
      "common/**/*.ts",
      "logger/**/*.ts",
      "database/**/*.ts",
      "!**/*.entity.ts",
      "!**/*.module.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 91,
        "functions": 99,
        "lines": 99,
        "statements": 99
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^axios$": "<rootDir>/__mocks__/axios.ts",
      "^@reactpressjs/reactpress-toolkit/(.*)$": "<rootDir>/../../toolkit/dist/$1",
      "^@reactpressjs/reactpress-toolkit$": "<rootDir>/../../toolkit/dist"
    }
  }
}
